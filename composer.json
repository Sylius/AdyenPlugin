{
    "name": "sylius/adyen-plugin",
    "type": "sylius-plugin",
    "description": "Adyen payment plugin for Sylius applications.",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "adyen"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "adyen/php-api-library": "^28.0",
        "composer/package-versions-deprecated": "^1.11",
        "sylius/refund-plugin": "^2.0",
        "sylius/sylius": "^2.0",
        "sylius/telemetry": "^1.0",
        "symfony/messenger": "^6.4 || ^7.4 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "require-dev": {
        "behat/behat": "^3.22 || 4.0.0-alpha1",
        "behat/mink": "^1.10 || ^1.13",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink-browserkit-driver": "^1.6.3",
        "friends-of-behat/mink-debug-extension": "^2.2",
        "friends-of-behat/mink-extension": "^2.7 || 3.0.0-alpha1",
        "friends-of-behat/page-object-extension": "^0.4",
        "friends-of-behat/symfony-extension": "^2.6.2",
        "friends-of-behat/variadic-extension": "^1.6",
        "nyholm/psr7": "^1.8",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "sylius-labs/behat-chrome-extension": "^1.5",
        "sylius-labs/coding-standard": "^4.0",
        "sylius/test-application": "^2.2.0@alpha || ^2.3.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0"
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-gs8r-6kz6-pp56",
                "PKSA-gnn4-pxdg-q76m"
            ]
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": true
        }
    },
    "conflict": {
        "liip/imagine-bundle": "2.17.0"
    },
    "extra": {
        "branch-alias": {
            "dev-2.0": "2.0-dev"
        },
        "symfony": {
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "Sylius\\AdyenPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Sylius\\AdyenPlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    }
}
