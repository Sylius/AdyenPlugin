<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true"/>

        <service
            id="sylius_adyen.api.shop.open_api.documentation_modifier.dropin_configuration"
            class="Sylius\AdyenPlugin\Api\OpenApi\AdyenDropinConfigurationDocumentationModifier"
        >
            <argument>%sylius.security.api_shop_route%</argument>

            <tag name="sylius.open_api.modifier" />
        </service>

        <service
            id="sylius_adyen.api.shop.open_api.documentation_modifier.thank_you"
            class="Sylius\AdyenPlugin\Api\OpenApi\AdyenThankYouDocumentationModifier"
        >
            <argument>%sylius.security.api_shop_route%</argument>

            <tag name="sylius.open_api.modifier" />
        </service>

        <service
            id="sylius_adyen.api.shop.open_api.documentation_modifier.payment_details"
            class="Sylius\AdyenPlugin\Api\OpenApi\AdyenPaymentDetailsDocumentationModifier"
        >
            <argument>%sylius.security.api_shop_route%</argument>

            <tag name="sylius.open_api.modifier" />
        </service>
    </services>
</container>
